{
  "name": "bonniepdf-js",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "lint": "eslint core/src core/tests",
    "lint:fix": "eslint core/src core/tests --fix",
    "prepare": "husky",
    "generate-tagged": "tsx scripts/generate-tagged-pdfs.ts",
    "check:preflight": "tsx scripts/check-preflight.ts",
    "generate-showcase": "tsx scripts/generate-showcase-assets.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,json,md}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "tsx": "^4.23.12",
    "turbo": "latest",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=11.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

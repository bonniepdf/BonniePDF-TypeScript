{
  "name": "@bonniepdf/core",
  "version": "2026.7.2",
  "description": "Zero-dependency PDF generation for TypeScript & JavaScript - runs in the browser, Node.js, and serverless. Layout engine with tables, charts, accessible (PDF/UA) and archival (PDF/A) output.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/index.node.js",
    "./dist/index.node.cjs"
  ],
  "files": [
    "dist",
    "assets",
    "LICENSE",
    "COMMERCIAL-LICENSE.txt",
    "THIRD-PARTY-NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": {
        "types": "./dist/index.node.d.ts",
        "import": "./dist/index.node.js",
        "require": "./dist/index.node.cjs"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js",
      "require": "./dist/charts.cjs"
    },
    "./security": {
      "types": "./dist/security.d.ts",
      "import": "./dist/security.js",
      "require": "./dist/security.cjs"
    },
    "./qr": {
      "types": "./dist/qr.d.ts",
      "import": "./dist/qr.js",
      "require": "./dist/qr.cjs"
    },
    "./datamatrix": {
      "types": "./dist/datamatrix.d.ts",
      "import": "./dist/datamatrix.js",
      "require": "./dist/datamatrix.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tsup --config tsup.cjs.config.ts && node scripts/fix-esm-extensions.mjs dist && tsc --noEmit false --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "prepack": "pnpm run build",
    "clean": "node --input-type=module -e \"import { rmSync } from 'fs'; rmSync('dist', { recursive: true, force: true });\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage": "vitest run --coverage && node ../scripts/coverage-badge.mjs",
    "test:pdf-validation": "pnpm run build && node scripts/validate-pdfa4-samples.mjs"
  },
  "keywords": [
    "pdf",
    "pdf-generation",
    "pdf-generator",
    "generate-pdf",
    "document",
    "typescript",
    "javascript",
    "browser-pdf",
    "client-side-pdf",
    "invoice",
    "report",
    "charts",
    "tables",
    "fluent-api",
    "zero-dependency",
    "pdf-ua",
    "pdf-a",
    "accessible-pdf",
    "pdfkit-alternative",
    "nodejs"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "BonniePDF",
  "repository": {
    "type": "git",
    "url": "https://github.com/bonniepdf/bonniepdf-typescript",
    "directory": "core"
  },
  "bugs": {
    "url": "https://github.com/bonniepdf/bonniepdf-typescript/issues"
  },
  "homepage": "https://bonniepdf.dev",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "tsup": "^8.5.1",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

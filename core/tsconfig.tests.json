{
  // Typechecks the test suite, which `tsconfig.json` deliberately cannot.
  //
  // That config drives declaration emit (`rootDir: "src"`, consumed by the
  // build's `--emitDeclarationOnly`), so widening its `include` to cover tests
  // would emit .d.ts files for them into dist/. The result was that `pnpm
  // typecheck` never looked at tests/ at all, and 132 type errors accumulated
  // there unseen - including 76 calls passing three arguments to a constructor
  // that declares two, where the extra arguments were silently discarded at
  // runtime and the tests were not exercising the fonts and sizes they named.
  //
  // Only `tests/**` is listed: everything under src/ that the tests import is
  // pulled into the program automatically, and the sibling config still covers
  // src/ in full, including files no test touches.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "."
  },
  "include": ["tests/**/*"]
}

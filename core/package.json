{
  "name": "@bonniepdf/core",
  "version": "2026.11.13",
  "description": "Zero-dependency PDF generation for TypeScript & JavaScript - runs in the browser, Node.js, and serverless. Layout engine with tables, charts, accessible (PDF/UA) and archival (PDF/A) output.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/index.node.js",
    "./dist/index.node.cjs"
  ],
  "files": [
    "dist",
    "assets",
    "LICENSE",
    "COMMERCIAL-LICENSE.txt",
    "THIRD-PARTY-NOTICES.md"
  ],
  "exports": {
    ".": {
      "node": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.node.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.node.cjs"
        }
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./charts": {
      "import": {
        "types": "./dist/charts.d.ts",
        "default": "./dist/charts.js"
      },
      "require": {
        "types": "./dist/charts.d.cts",
        "default": "./dist/charts.cjs"
      }
    },
    "./security": {
      "import": {
        "types": "./dist/security.d.ts",
        "default": "./dist/security.js"
      },
      "require": {
        "types": "./dist/security.d.cts",
        "default": "./dist/security.cjs"
      }
    },
    "./qr": {
      "import": {
        "types": "./dist/qr.d.ts",
        "default": "./dist/qr.js"
      },
      "require": {
        "types": "./dist/qr.d.cts",
        "default": "./dist/qr.cjs"
      }
    },
    "./datamatrix": {
      "import": {
        "types": "./dist/datamatrix.d.ts",
        "default": "./dist/datamatrix.js"
      },
      "require": {
        "types": "./dist/datamatrix.d.cts",
        "default": "./dist/datamatrix.cjs"
      }
    },
    "./definition": {
      "import": {
        "types": "./dist/definition.d.ts",
        "default": "./dist/definition.js"
      },
      "require": {
        "types": "./dist/definition.d.cts",
        "default": "./dist/definition.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/verify-chart-sources.mjs && tsup && tsup --config tsup.cjs.config.ts && node scripts/fix-esm-extensions.mjs dist && tsc --noEmit false --emitDeclarationOnly --declaration --declarationMap --outDir dist && node scripts/fix-esm-extensions.mjs dist && node scripts/emit-cjs-declarations.mjs dist",
    "check:consumer-types": "tsc -p scripts/consumer-types/tsconfig.json",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "prepack": "pnpm run build",
    "clean": "node --input-type=module -e \"import { rmSync } from 'fs'; rmSync('dist', { recursive: true, force: true });\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage": "vitest run --coverage && node ../scripts/coverage-badge.mjs",
    "test:pdf-validation": "pnpm run build && node scripts/validate-pdfa4-samples.mjs"
  },
  "keywords": [
    "pdf",
    "pdf-generation",
    "pdf-generator",
    "generate-pdf",
    "document",
    "typescript",
    "javascript",
    "browser-pdf",
    "client-side-pdf",
    "invoice",
    "report",
    "charts",
    "tables",
    "fluent-api",
    "zero-dependency",
    "pdf-ua",
    "pdf-a",
    "accessible-pdf",
    "pdfkit-alternative",
    "nodejs"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "CodeFocus Limited",
  "repository": {
    "type": "git",
    "url": "https://github.com/bonniepdf/bonniepdf-typescript",
    "directory": "core"
  },
  "bugs": {
    "url": "https://github.com/bonniepdf/bonniepdf-typescript/issues"
  },
  "homepage": "https://bonniepdf.dev",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "pdfjs-dist": "^6.4.299",
    "tsup": "^9.0.0",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

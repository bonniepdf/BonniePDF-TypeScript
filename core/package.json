{
  "name": "@bonniepdf/core",
  "version": "2026.5.0",
  "description": "Zero-dependency PDF generation for TypeScript & JavaScript - runs in the browser, Node.js, and serverless. Layout engine with tables, charts, accessible (PDF/UA) and archival (PDF/A) output.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/index.node.js",
    "./dist/index.node.cjs"
  ],
  "files": [
    "dist",
    "assets"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": {
        "types": "./dist/index.node.d.ts",
        "import": "./dist/index.node.js",
        "require": "./dist/index.node.cjs"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js",
      "require": "./dist/charts.cjs"
    },
    "./security": {
      "types": "./dist/security.d.ts",
      "import": "./dist/security.js",
      "require": "./dist/security.cjs"
    },
    "./qr": {
      "types": "./dist/qr.d.ts",
      "import": "./dist/qr.js",
      "require": "./dist/qr.cjs"
    },
    "./prototyping": {
      "types": "./dist/prototyping.d.ts",
      "import": "./dist/prototyping.js",
      "require": "./dist/prototyping.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build",
    "clean": "node --input-type=module -e \"import { rmSync } from 'fs'; rmSync('dist', { recursive: true, force: true });\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "pdf",
    "pdf-generation",
    "pdf-generator",
    "generate-pdf",
    "document",
    "typescript",
    "javascript",
    "browser-pdf",
    "client-side-pdf",
    "invoice",
    "report",
    "charts",
    "tables",
    "fluent-api",
    "zero-dependency",
    "pdf-ua",
    "pdf-a",
    "accessible-pdf",
    "pdfkit-alternative",
    "nodejs"
  ],
  "license": "UNLICENSED",
  "author": "BonniePDF",
  "repository": {
    "type": "git",
    "url": "https://github.com/bonniepdf/bonniepdf-typescript",
    "directory": "core"
  },
  "bugs": {
    "url": "https://github.com/bonniepdf/bonniepdf-typescript/issues"
  },
  "homepage": "https://bonniepdf.dev",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

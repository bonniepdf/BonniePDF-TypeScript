<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared Factur-X / ZUGFeRD 2.x conformance fixture, EN 16931 (COMFORT) profile.

  This is a caller-supplied invoice XML: BonniePDF embeds it verbatim, it does
  not generate it. Both the .NET and TypeScript example projects embed a copy
  of this exact file so the shared conformance suite and the CI ZUGFeRD gate
  (Mustang) validate identical bytes.

  Arithmetic (EN 16931 BR-CO-* calculation rules) reconciles exactly:
    line 1: 40 HUR x 85.00 = 3400.00
    line 2:  1 C62 x 600.00 =  600.00
    line total (BT-106)        = 4000.00
    tax basis  (BT-109)        = 4000.00
    VAT 19% S  (BT-110)        =  760.00
    grand total(BT-112)        = 4760.00
    due payable(BT-115)        = 4760.00
-->

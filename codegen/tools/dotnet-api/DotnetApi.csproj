<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BonniePDF"><HintPath>$(BonniePdfAssembly)</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireAssembly" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(BonniePdfAssembly)')" Text="Supply -p:BonniePdfAssembly with the public BonniePDF assembly to inspect." />
  </Target>
</Project>
